{
  "expo": {
    "name": "Синкли",
    "slug": "syncli-patient",
    "version": "0.4.4",
    "scheme": "syncli",
    "orientation": "portrait",
    "icon": "./assets/images/fluffy.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/fluffy.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F5ED"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.syncli.patient.demo"
    },
    "android": {
      "package": "ru.syncli.patient.demo",
      "versionCode": 8,
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/fluffy.png",
        "backgroundColor": "#D6E5BE"
      },
      "predictiveBackGestureEnabled": true,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "defaultChannel": "syncli_reminders",
          "color": "#2C5740"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
