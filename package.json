{
  "name": "psycho-repository-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web-doctor",
    "apps/web-admin",
    "apps/mobile-patient",
    "packages/ui-web"
  ],
  "description": "Проверки и инструменты репозитория команды Клинического компаса",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:mobile": "npm run start --workspace @psycho/mobile-patient",
    "check:mobile": "npm run typecheck --workspace @psycho/mobile-patient && npm run lint --workspace @psycho/mobile-patient && node --test apps/mobile-patient/tests/*.test.ts",
    "dev": "vite site --host 127.0.0.1",
    "build": "vite build site --base ./ --outDir ../dist --emptyOutDir",
    "preview": "vite preview site --host 127.0.0.1 --outDir ../dist",
    "site:check": "node --check site/app.js",
    "dev:doctor": "npm run dev --workspace @psycho/web-doctor --",
    "dev:admin": "npm run dev --workspace @psycho/web-admin --",
    "dev:examples": "node scripts/dev-examples.mjs",
    "check:fixtures": "vitest run --project fixtures && node scripts/check-fixtures.ts",
    "check:web": "npm run contract:doctor:check && npm run check:doctor:forms && tsc --noEmit && vitest run --project web --project tools && npm run build --workspace @psycho/web-doctor && npm run build --workspace @psycho/web-admin",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "docs:check": "remark . .github --frail --no-stdout --quiet",
    "check": "npm run format:check && npm run docs:check && npm run site:check && npm run build",
    "contract:doctor": "node scripts/generate-doctor-contract.mjs",
    "contract:doctor:check": "node scripts/generate-doctor-contract.mjs --check",
    "prepare:doctor:forms": "node scripts/prepare-doctor-forms.mjs",
    "check:doctor:forms": "node scripts/prepare-doctor-forms.mjs --self-test",
    "setup:doctor:local": "node scripts/setup-doctor-local.mjs",
    "build:doctor:api": "node scripts/doctor-service.mjs build",
    "dev:doctor:api": "node scripts/doctor-service.mjs",
    "provision:doctor": "node scripts/doctor-service.mjs provision",
    "check:doctor:api": "node scripts/verify-doctor-api.mjs",
    "check:doctor:policy": "node scripts/verify-clinical-policy.mjs",
    "check:layero": "vitest run --project tools scripts/layero-proxy.test.ts scripts/layero-layout.test.ts",
    "check:doctor:ui": "node scripts/verify-doctor-ui.mjs",
    "check:doctor:restore": "node scripts/verify-doctor-restore.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "playwright": "1.62.1",
    "prettier": "3.9.10",
    "remark-cli": "12.0.1",
    "remark-gfm": "4.0.1",
    "remark-lint-no-undefined-references": "5.0.2",
    "remark-validate-links": "13.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "unified-args": {
      "chokidar": "5.0.0"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
