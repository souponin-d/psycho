{
  "name": "psycho-repository-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web-doctor",
    "apps/web-admin",
    "packages/ui-web"
  ],
  "description": "Проверки и инструменты репозитория команды Клинического компаса",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite site --host 127.0.0.1",
    "build": "vite build site --base ./ --outDir ../dist --emptyOutDir",
    "preview": "vite preview site --host 127.0.0.1 --outDir ../dist",
    "site:check": "node --check site/app.js",
    "dev:doctor": "npm run dev --workspace @psycho/web-doctor --",
    "dev:admin": "npm run dev --workspace @psycho/web-admin --",
    "dev:examples": "node scripts/dev-examples.mjs",
    "check:fixtures": "vitest run --project fixtures && node scripts/check-fixtures.ts",
    "check:web": "tsc --noEmit && vitest run --project web --project tools && npm run build --workspace @psycho/web-doctor && npm run build --workspace @psycho/web-admin",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "docs:check": "remark . .github --frail --no-stdout --quiet",
    "check": "npm run format:check && npm run docs:check && npm run site:check && npm run build"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "remark-cli": "12.0.1",
    "remark-gfm": "4.0.1",
    "remark-lint-no-undefined-references": "5.0.2",
    "remark-validate-links": "13.1.0",
    "vite": "8.3.4",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "unified-args": {
      "chokidar": "5.0.0"
    }
  }
}
